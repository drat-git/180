VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Optional, server-side setup scripts only. Never prefix these with VITE_.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_PROJECT_REF=xlkmnczbuzmdfchoqqbr
# Keep false until SMTP/email delivery and recovery redirects are configured.
VITE_PASSWORD_RECOVERY_ENABLED=false
